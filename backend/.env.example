# Server Configuration
PORT=5000
NODE_ENV=development

# Database Configuration
# Lưu ý: docker-compose dùng host=mysql (service name), ngoài Docker dùng localhost.
# Port mặc định 3306; chỉ đổi nếu MySQL local của bạn đang chạy port khác.
DB_HOST=localhost
DB_PORT=3306
DB_NAME=mobile_shop
DB_USER=techmart_user
DB_PASSWORD=techmart123

# JWT Configuration
# QUAN TRỌNG: Backend sẽ throw lỗi khởi động nếu thiếu JWT_SECRET (chống fallback "secret").
# Production phải đổi giá trị này thành chuỗi random ≥32 ký tự.
JWT_SECRET=techmart_jwt_secret_key_2026
JWT_EXPIRES_IN=7d

# CORS Configuration
CORS_ORIGIN=http://localhost:5173,http://localhost:5174

# File Upload
UPLOAD_PATH=uploads
MAX_FILE_SIZE=5242880

# VNPay Sandbox - Đăng ký tại https://sandbox.vnpayment.vn/
# Vào "Quản lý website" -> lấy TMN Code và Secret Key
VNPAY_TMN_CODE=your_vnpay_tmn_code
VNPAY_HASH_SECRET=your_vnpay_hash_secret
VNPAY_RETURN_URL=http://localhost:5001/api/payment/vnpay/return
FRONTEND_URL=http://localhost:5173

# Email SMTP - Dùng Gmail App Password
# Hướng dẫn: Bật 2FA Gmail > Tạo App Password tại https://myaccount.google.com/apppasswords
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_gmail_app_password
SMTP_FROM_NAME=TechMart

# Groq API - Chatbot AI (đăng ký free tại https://console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key
