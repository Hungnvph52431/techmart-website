# Backend API URL
# - Khi chạy bằng Docker (docker compose up): biến VITE_API_URL trong docker-compose.yml
#   sẽ được dùng, KHÔNG cần file .env này.
# - Khi chạy thủ công (npm run dev): copy file này thành .env và để URL trỏ về backend
#   localhost (mặc định backend listen ở port 5001 theo docker-compose).
VITE_API_URL=http://localhost:5001/api
