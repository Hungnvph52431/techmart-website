# ══════════════════════════════════════════════════════════════
# TechMart — Environment template
# Copy file này thành .env rồi điền giá trị thật:
#     cp .env.example .env
#
# File .env đã được gitignore — KHÔNG commit lên git.
# docker-compose tự đọc .env cùng cấp khi chạy `docker compose up`.
# ══════════════════════════════════════════════════════════════

# ───────────────────────────────────────────────────────────
# 1. SECRET cho cả DEV và PROD (BẮT BUỘC điền trước khi up)
# ───────────────────────────────────────────────────────────

# Gmail SMTP — gửi email xác nhận đơn / OTP / nạp ví
# Cách lấy:
#   1. Bật xác minh 2 bước: https://myaccount.google.com/security
#   2. Tạo App Password: https://myaccount.google.com/apppasswords
#   3. Copy mật khẩu 16 ký tự (có dấu cách) vào SMTP_PASS
SMTP_USER=youremail@gmail.com
SMTP_PASS=xxxx xxxx xxxx xxxx

# VNPay Sandbox — thanh toán online
# Đăng ký merchant test: https://sandbox.vnpayment.vn/devreg/
VNPAY_TMN_CODE=YOUR_TMN_CODE
VNPAY_HASH_SECRET=YOUR_HASH_SECRET

# Groq AI — chatbot tư vấn sản phẩm
# Lấy free tại: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# ───────────────────────────────────────────────────────────
# 2. Chỉ cần điền nếu dùng docker-compose.prod.yml (deploy)
# ───────────────────────────────────────────────────────────
DB_ROOT_PASSWORD=techmart123
DB_NAME=mobile_shop
DB_USER=techmart_user
DB_PASSWORD=techmart123

JWT_SECRET=techmart_jwt_secret_key_2026

CORS_ORIGIN=http://localhost
FRONTEND_URL=http://localhost
VNPAY_RETURN_URL=http://localhost:5001/api/payment/vnpay/return

# Frontend API URL (bake vào lúc build prod)
VITE_API_URL=http://localhost/api

SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
